# Neon hands out two strings: pooled (DATABASE_URL) serves traffic, direct
# (DIRECT_URL) runs migrations. For local dev both can be the same local DB.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/notes"
DIRECT_URL="postgresql://postgres@127.0.0.1:5432/notes"

# Must be at least 16 characters. Generate one: openssl rand -base64 32
JWT_SECRET="dev-only-change-me-please-123456"

PORT=3000
NODE_ENV=development

# Comma-separated allowlist. Expo dev + device builds send no Origin, so the
# API already allows origin-less requests; add any web origins here.
CORS_ORIGINS="http://localhost:8081"
