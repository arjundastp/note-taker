generator client {
  provider = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — serves requests
  directUrl = env("DIRECT_URL")   // unpooled — runs migrations
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique // lowercased, trimmed
  passwordHash String // argon2id
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  notes    Note[]
}

/// One row per logged-in device, so a single device can be revoked.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the refresh token — never the token
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("text") // "text" | "sketch"
  title     String   @default("Untitled") // first line of body; client-derived
  bodyHtml  String? // text notes only
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  image NoteImage?

  @@index([userId, isPinned, updatedAt(sort: Desc)])
}

/// Sketch PNG bytes live here, not on Note, so list queries never pull images.
model NoteImage {
  noteId   String @id
  bytes    Bytes
  mimeType String @default("image/png")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
}
