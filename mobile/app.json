{
  "expo": {
    "name": "Notes",
    "slug": "notes-app",
    "scheme": "notesapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "deunapp.in"
    },
    "android": {
      "package": "deunapp.in",
      "adaptiveIcon": {
        "backgroundColor": "#E8B000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "./plugins/withArm64Only.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFDF4",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#1C1C1E"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://note-taker-nu-lemon.vercel.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "21e61860-da29-4dc8-ae0a-4348c460dba2"
      }
    },
    "owner": "arjundastp3333"
  }
}
